# The Cockpit remains deterministic until live data is selected explicitly.
NEXT_PUBLIC_DATA_SOURCE=fixtures
NEXT_PUBLIC_API_BASE=http://localhost:8010

# Live mode only: the case whose checklist the Cockpit follows.
NEXT_PUBLIC_CASE_ID=CASE-001
# Supplier left uncalled when the Cockpit triggers a run, e.g. SUP-KBY for the
# live CALL-E moment. Empty means every compliant supplier is asked.
NEXT_PUBLIC_HOLD_FOR=
# Dwell per checklist step (milliseconds) when the Cockpit triggers a run.
NEXT_PUBLIC_PACE_MS=1500
