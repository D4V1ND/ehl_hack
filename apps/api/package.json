{
  "name": "@supplyos/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "setup": "node ../../scripts/py.mjs --setup",
    "dev": "node ../../scripts/py.mjs -m uvicorn backend.api.main:app --reload --host 127.0.0.1 --port ${API_PORT:-8010}",
    "build": "python3 -m compileall -q backend packages orchestrator",
    "test": "node ../../scripts/py.mjs -m pytest -v -m \"not live\"",
    "db:seed": "node ../../scripts/py.mjs -m backend.record.seed_db"
  }
}
