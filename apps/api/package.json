{
  "name": "@supplyos/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "setup": "python3 -m venv .venv && .venv/bin/python -m pip install --quiet --upgrade pip && .venv/bin/python -m pip install --quiet -e \".[dev]\"",
    "dev": ".venv/bin/python -m uvicorn backend.api.main:app --reload --host 127.0.0.1 --port ${API_PORT:-8010}",
    "build": "python3 -m compileall -q backend packages orchestrator",
    "test": ".venv/bin/python -m pytest -v -m \"not live\"",
    "db:seed": ".venv/bin/python -m backend.record.seed_db"
  }
}
