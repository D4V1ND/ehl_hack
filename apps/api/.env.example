# Rehearsal is the default. Keep this at 1 unless live calls are intended.
FAKE_CALLS=1
RECORD_BACKEND=sqlite

# Live CALL-E configuration. Never commit real values.
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com
PUBLIC_BASE_URL=http://localhost:8010

# Optional controlled destination for a live rehearsal.
DEMO_SUPPLIER_PHONE=

# Optional Devin session launcher.
DEVIN_API_KEY=
