{
  "name": "supplyos",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@supplyos/web",
    "dev:erp": "turbo dev --filter=@supplyos/erp",
    "dev:api": "turbo dev --filter=@supplyos/api",
    "setup:api": "pnpm --filter=@supplyos/api run setup",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:seed": "turbo db:seed --filter=@supplyos/api",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.8.0"
  }
}
