{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/entire-cursor.ps1 before-submit-prompt"
      }
    ],
    "preCompact": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/entire-cursor.ps1 pre-compact"
      }
    ],
    "sessionEnd": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/entire-cursor.ps1 session-end"
      }
    ],
    "sessionStart": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/entire-cursor.ps1 session-start"
      }
    ],
    "stop": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/entire-cursor.ps1 stop"
      }
    ],
    "subagentStart": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/entire-cursor.ps1 subagent-start"
      }
    ],
    "subagentStop": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/entire-cursor.ps1 subagent-stop"
      }
    ]
  }
}
