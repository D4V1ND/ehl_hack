# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# CALL-E API key (https://heycall-e.com). Required to place any call, live or not.
CALLE_API_KEY=

# Override only if CALL-E gives you a different base URL than the default.
CALLE_BASE_URL=https://api.heycall-e.com

# Where a finished call is delivered: <PUBLIC_BASE_URL>/calle/webhook. Leave this
# blank -- with FAKE_CALLS=0, `python run.py` opens a Cloudflare quick tunnel and
# fills it in for the run. Set it only to pin your own tunnel or a deployed host.
PUBLIC_BASE_URL=

# Live calling. "1" (the default) is rehearsal: nothing is dialled. Set to "0"
# only when you mean to spend real calls -- and set DEMO_CALL_NUMBER below,
# because live dispatch refuses rather than dialling a supplier on record.
FAKE_CALLS=1

# The one E.164 number live calls are allowed to reach: a phone someone on the
# team is holding. Every supplier in the demo rings this number and the supplier
# identity travels as call metadata.
DEMO_CALL_NUMBER=

# Not used by test/test_calle.py yet — reserved for later work (langchain-openai reasoning).
OPENAI_API_KEY=

# E.164 phone number YOU control that the live test is allowed to dial (e.g. +12125550100).
# Leave blank to keep the live-call test skipped.
TEST_CALL_DESTINATION_NUMBER=

# Extra explicit confirmation required (in addition to the number above) before
# test/test_calle.py will place a real call and spend a real credit.
# Must be exactly: yes-call-my-phone
CALLE_LIVE_TEST_CONFIRM=
