# Copy to .env. The file is gitignored; keep secrets and real phone numbers out
# of the repository.

# Safe defaults. A live call needs both values changed deliberately and an
# explicit `--live` request.
FAKE_CALLS=1
LIVE_CALLS=

# CALL-E provider settings. CALLE_API_KEY is required only for a live call.
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com
CALLE_LOCALE=en-US
CALLE_REGION=DE
CALLE_POLL_INTERVAL=10
CALLE_POLL_TIMEOUT=900

# Send every deliberate live demo call to one E.164 number controlled by the
# operator. Leave empty in ordinary development.
DEMO_CALL_DESTINATION=
BUYER_NAME=Meridian Motors

# Deterministic rehearsal timing.
FAKE_MIN_DELAY=0.4
FAKE_MAX_DELAY=2.5

# `sqlite` is the compiled mock ERP; `yaml` is the reference adapter.
RECORD_BACKEND=sqlite
QUOTES_DIR=

# Devin is optional. Without a key, opening an incident returns a stub session.
DEVIN_API_KEY=
DEVIN_API_BASE_URL=https://api.devin.ai

# Public address a remote Devin session can use to call this API.
PUBLIC_BASE_URL=

# Extra browser origins, comma separated. Local ERP and SupplyOS ports are
# already allowed. Never use a wildcard: these routes can start sessions/calls.
CASES_ALLOWED_ORIGINS=

# Optional pull-request publishing. Unset keeps publishing in dry-run mode.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main
