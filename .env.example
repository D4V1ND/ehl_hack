# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Runtime mode ----------------------------------------------------------

# System-of-record adapter: sqlite (default) or yaml.
RECORD_BACKEND=sqlite

# Safe defaults: calls are rehearsed and no real phone number is dialled. Real
# calls require both FAKE_CALLS=0 and LIVE_CALLS=yes-place-real-calls.
FAKE_CALLS=1
LIVE_CALLS=

# --- CALL-E supplier calls -------------------------------------------------

# CALL-E API key (https://heycall-e.com). Required only for real calls.
CALLE_API_KEY=

# Override only if CALL-E gives you a different base URL than the default.
CALLE_BASE_URL=https://api.heycall-e.com

# One number every supplier call goes to on the demo machine. E.164, e.g.
# +4915112345678. Leave blank to use supplier fixture numbers.
DEMO_CALL_DESTINATION=

# The identity and locale spoken by the calling agent.
BUYER_NAME=Meridian Motors
CALLE_LOCALE=en-US
CALLE_REGION=DE

# Polling controls for real calls, in seconds.
CALLE_POLL_INTERVAL=10
CALLE_POLL_TIMEOUT=900

# Fake-provider response delay range, in seconds.
FAKE_MIN_DELAY=0.4
FAKE_MAX_DELAY=2.5

# Quote persistence directory.
QUOTES_DIR=data/quotes

# --- Devin sourcing sessions ----------------------------------------------

# Leave blank to keep POST /cases on the stub session path.
DEVIN_API_KEY=

# Override only for a non-default Devin API host.
DEVIN_API_BASE_URL=https://api.devin.ai

# Optional maximum ACU budget sent when creating a Devin session.
DEVIN_MAX_ACU=

# Public URL of the FastAPI backend handed to Devin so it can call back. At
# demo time this is the cloudflared URL. DEVIN_BACKEND_BASE_URL is the legacy
# fallback; prefer PUBLIC_BASE_URL.
PUBLIC_BASE_URL=
DEVIN_BACKEND_BASE_URL=

# Comma-separated extra browser origins allowed to call the API. Local ports
# 3000 and 3001 are already trusted. Never use a wildcard: these routes start
# Devin sessions and can place calls.
CASES_ALLOWED_ORIGINS=

# --- Web app ---------------------------------------------------------------

# Both frontends use live API data when the full stack is started.
NEXT_PUBLIC_DATA_SOURCE=live
NEXT_PUBLIC_API_BASE=http://localhost:8010

# Defaults for sessions launched from the web app.
NEXT_PUBLIC_PART_ID=PRT-6204
NEXT_PUBLIC_CASE_ID=CASE-001
NEXT_PUBLIC_HOLD_FOR=
NEXT_PUBLIC_PACE_MS=1500

# --- Publishing the decision as a pull request ----------------------------

# Fine-grained token with Contents: write and Pull requests: write. Leave
# blank to keep POST /tools/publish_pr in rehearsal mode.
GITHUB_TOKEN=
# Repository in owner/name form, e.g. D4V1ND/ehl_hack.
GITHUB_REPO=
GITHUB_BASE_BRANCH=main

# --- Local service ports ---------------------------------------------------

UI_PORT=3000
ERP_PORT=3001
API_PORT=8010
