# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# CALL-E API key (https://heycall-e.com). Required to place any call, live or not.
CALLE_API_KEY=

# Override only if CALL-E gives you a different base URL than the default.
CALLE_BASE_URL=https://api.heycall-e.com

# Not used by test/test_calle.py yet — reserved for later work (langchain-openai reasoning).
OPENAI_API_KEY=

# E.164 phone number YOU control that the live test is allowed to dial (e.g. +12125550100).
# Leave blank to keep the live-call test skipped.
TEST_CALL_DESTINATION_NUMBER=

# Extra explicit confirmation required (in addition to the number above) before
# test/test_calle.py will place a real call and spend a real credit.
# Must be exactly: yes-call-my-phone
CALLE_LIVE_TEST_CONFIRM=

# One number every supplier call goes to. Set this on the demo machine and CALL-E
# dials the phone on stage instead of a supplier, whichever supplier is being
# asked. E.164, e.g. +4915112345678. Leave blank to use the fixture numbers.
DEMO_CALL_DESTINATION=

# Devin API key (https://docs.devin.ai/api-reference). Leave blank to keep
# POST /cases on the stub session path — opening a case works either way.
DEVIN_API_KEY=

# Override only for a non-default Devin API host.
DEVIN_API_BASE_URL=https://api.devin.ai

# Public URL of the FastAPI backend, handed to the Devin session so it can call
# back — the cloudflared URL at demo time. Falls back to the request origin,
# which is localhost and unreachable from outside.
PUBLIC_BASE_URL=
DEVIN_BACKEND_BASE_URL=

# Comma-separated origins allowed to call the API from a browser. Empty trusts
# the local dev UI on :3000 and :3001 and nothing else; add a deployed UI origin
# here. Never a wildcard: these routes start Devin sessions and place calls.
CASES_ALLOWED_ORIGINS=

# --- Publishing the decision as a pull request (backend/publish) -------------

# Fine-grained GitHub token with Contents: write and Pull requests: write on the
# repo below. Leave blank to keep POST /tools/publish_pr in rehearsal: it reports
# the branch and files it would have pushed and opens nothing.
GITHUB_TOKEN=

# owner/repo the procurement PR is opened against, e.g. D4V1ND/ehl_hack.
GITHUB_REPO=

# Base branch for that PR. Defaults to main.
GITHUB_BASE_BRANCH=main
