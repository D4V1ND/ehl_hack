# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
.vinext/
out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/.herenow/
# production
build/
pnpm-debug.log*
# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# SQL system of record — a build artifact, rebuilt by `./run.sh db`
backend/record/*.db

# run.py writes background logs here
.logs/

# a real supplier number for a live call never belongs in git
backend/fixtures/supplier_phones.local.json

# Case output belongs to a run, not to the repo. The two seeded cases keep their
# events.jsonl and sourcing_case.yaml; everything a run writes stays local.
cases/*/candidates.json
cases/*/claims/
cases/*/decision.json
cases/*/outreach.json
cases/*/incident.json
cases/*/*.md
